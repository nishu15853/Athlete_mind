# AthleteMind Frontend Environment Configuration

# Backend WebSocket Endpoint (Used for real-time biomechanics telemetry)
# Defaults to: ws://localhost:8000/ws/pose
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/pose

# Google Gemini API Key (Optional - for AI Coach dialogue & Clinical SOAP Note generation)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
